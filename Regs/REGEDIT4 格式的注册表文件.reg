REGEDIT4

; 这是注释
; 文件默认保存为用户区域的默认编码格式

[HKEY_CURRENT_USER\Test\REGEDIT4] ; 注释可以写在这里
@="这是一个默认值" ; 也可以写在这里
"字符串值"="这是一个字符串！"
"DWORD (32 位)值"=dword:00000001
"QWORD (64 位)值"=hex(b):7f,7f,7f,7f,7f,7f,7f,7f
"二进制值"=hex:01,23,45,67,89,ab,cd,ef
"空的二进制值"=hex:
"多字符串值"=hex(7):d9,8f,2f,66,2c,7b,00,4e,4c,88,01,ff,00,00,d9,8f,2f,66,2c,7b,8c,\ ; 还可以写在这里
  4e,4c,88,01,ff,00,00,d9,8f,2f,66,2c,7b,09,4e,4c,88,01,ff,00,00,d9,8f,2f,66,\
  2c,7b,db,56,4c,88,01,ff,00,00,d9,8f,2f,66,2c,7b,94,4e,4c,88,01,ff,00,00,00,\
  00
"可扩充字符串值"=hex(2):25,00,50,00,72,00,6f,00,67,00,72,00,61,00,6d,00,46,00,69,00,\
  6c,00,65,00,73,00,25,00,5c,00,4a,00,61,00,76,00,61,00,00,00
"大端序 DWORD (32 位)值"=hex(5):00,00,00,01
"没有指定类型的数据"=hex(0):00,00
"注册表链接"=hex(6):00,00
"资源列表"=hex(8):00,00
"资源数据"=hex(9):00,00
"REG_RESOURCE_REQUIREMENTS_LIST"=hex(a):00,00
"未被系统定义的数据类型"=hex(c):01,23,45,67,89,ab,cd,ef

